{
  "name": "@robertasoliman/n8n-nodes-sonarqube",
  "version": "0.0.6",
  "description": "n8n node for consuming SonarQube and SonarCloud Web API",
  "keywords": [
    "n8n-community-node-package",
    "n8n",
    "sonarqube",
    "sonarcloud",
    "code-quality",
    "static-analysis"
  ],
  "license": "MIT",
  "homepage": "https://github.com/robertasolimandonofreo/n8n-nodes-sonarqube",
  "author": {
    "name": "Roberta Soliman",
    "email": "roberta@rsdlab.dk"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/robertasolimandonofreo/n8n-nodes-sonarqube.git"
  },
  "engines": {
    "node": ">=18.10",
    "npm": ">=8.0.0"
  },
  "packageManager": "npm@10.1.0",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc && gulp build:icons",
    "dev": "tsc --watch",
    "format": "prettier nodes credentials --write",
    "lint": "eslint '**/*.ts' '**/*.js' --ignore-pattern dist --ignore-pattern node_modules",
    "lintfix": "eslint '**/*.ts' '**/*.js' --ignore-pattern dist --ignore-pattern node_modules --fix",
    "prepublishOnly": "npm run build && npm run lint"
  },
  "files": [
    "dist"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "credentials": [
      "dist/credentials/SonarQubeApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/SonarQube/SonarQube.node.js",
      "dist/nodes/SonarQube/SonarQubeTrigger.node.js"
    ]
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "@typescript-eslint/eslint-plugin": "^7.15.0",
    "@typescript-eslint/parser": "^7.15.0",
    "eslint": "^8.56.0",
    "eslint-plugin-n8n-nodes-base": "^1.16.1",
    "gulp": "^4.0.2",
    "n8n-workflow": "^1.52.0",
    "prettier": "^3.3.2",
    "typescript": "^5.5.3"
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  }
}
